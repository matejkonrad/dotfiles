{
  "favorites": [
    {
      "provider": "codex",
      "model": "gpt-6.2-sol"
    },
    {
      "provider": "claudeAgent",
      "model": "claude-opus-5-5"
    },
    {
      "provider": "cursor",
      "model": "gemini-4-neon"
    }
  ],
  "storageCleanup": {
    "worktreeAfterDays": 8,
    "worktreeOnDelete": true
  },
  "worktreesDirectory": "~/Project/worktrees",
  "fastWorktreeCheckout": true,
  "defaultAutoPull": true,
  "defaultModelSelection": {
    "instanceId": "codex",
    "model": "gpt-6.1-sol"
  },
  "projectSettingsFolded": true,
  "enableAgentDeviceAccess": true,
  "enableDeviceSupport": true,
  "deviceOnboardingCompleted": true,
  "idleCompaction": "onReturn",
  "textGenerationModelSelection": {
    "instanceId": "codex",
    "model": "gpt-6-luna",
    "options": [
      {
        "id": "reasoningEffort",
        "value": "low"
      },
      {
        "id": "serviceTier",
        "value": "default"
      }
    ]
  },
  "branchNamingMode": "semantic",
  "branchNamePrefix": "feat/",
  "removeAgentCreditsOnMerge": true,
  "providerInstances": {
    "cursor": {
      "driver": "cursor",
      "enabled": true,
      "config": {
        "binaryPath": "cursor-agent",
        "apiEndpoint": "",
        "customModels": []
      }
    },
    "opencode": {
      "driver": "opencode",
      "enabled": true,
      "config": {
        "binaryPath": "opencode",
        "serverUrl": "",
        "customModels": []
      }
    }
  }
}
