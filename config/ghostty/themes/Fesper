# Fesper: the terminal block of config/zed/themes/fesper.json.
background = #1a1a1a
# Zed uses #A0A0A0 here, but that is too dark for plain terminal text such as
# Claude Code. #DBDBDB is the Fesper variable color.
foreground = #dbdbdb
# Faint (SGR 2) text blends toward the background. The default 0.5 makes dim
# text almost invisible on #1A1A1A.
faint-opacity = 0.7
cursor-color = #ffc799
cursor-text = #1a1a1a
# Zed selection #FFC7993d, blended over the background.
selection-background = #514438
selection-foreground = cell-foreground

# The Zed palette puts red, yellow, magenta and cyan all in one pink-peach
# range, so tools that color by ANSI slot (opencode "system", git, ls) blur
# together. Each slot below has its own hue, kept soft to match Vesper.
palette = 0=#101010
palette = 1=#e67e80
palette = 2=#90b99f
palette = 3=#e5c07b
palette = 4=#82aad9
palette = 5=#c39ad8
palette = 6=#7fc8c2
palette = 7=#a0a0a0
palette = 8=#7e7e7e
palette = 9=#ff8080
palette = 10=#a8d8a0
palette = 11=#ffc799
palette = 12=#9cc0ec
palette = 13=#d6b3ea
palette = 14=#99ffe4
palette = 15=#ffffff
